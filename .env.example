# Groq API (free tier)
GROQ_API_KEY=gsk_...

# Gemini API (for AI Chat, Interview, Impact, Checklist, Document Checker, Status)
GEMINI_API_KEY=AIza...

# PayPal subscription plan ID for AI Chat ($9.99/month)
# Create a plan in your PayPal dashboard and paste the plan ID here
PAYPAL_CHAT_PLAN_ID=P-XXXXXXXXXXXXXX

# Cron secret — used to authenticate the /api/status/check endpoint
CRON_SECRET=replace-with-a-long-random-string

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox   # or "live"

# Pricing & URL
NEXT_PUBLIC_STRIPE_PRICE_USD_CENTS=2500
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel
ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Email replies (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Formixa Support <your@gmail.com>
